<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="OpenWordPad"
           Language="1033"
           Version="1.3.3.0"
           Manufacturer="Leonardo Corato"
           UpgradeCode="{D98A76B2-3C4E-481A-B982-581F78A690B4}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="OpenWordPad - Open Source WordPad recreation in Qt6"
             Comments="OpenWordPad Windows 64-bit Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenWordPad is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="resources/icons/app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/leocor/openwordpad" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/leocor/openwordpad" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="OpenWordPad" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="OpenWordPad" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="{7B9C12A3-4D5E-6F7A-8B9C-0D1E2F3A4B5C}">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="OpenWordPad"
                  Description="Open Source WordPad recreation in Qt6"
                  Target="[INSTALLFOLDER]openwordpad.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\LeonardoCorato\OpenWordPad" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{8C0D23B4-5E6F-7A8B-9C0D-1E2F3A4B5C6D}">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="OpenWordPad"
                  Description="Open Source WordPad recreation in Qt6"
                  Target="[INSTALLFOLDER]openwordpad.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\LeonardoCorato\OpenWordPad" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="OpenWordPad" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" SourceFile="installer/windows/License.rtf" />

  </Product>
</Wix>
